; OsmsPad.inf — mandos virtuales de OpenStreamMS (UMDF2 sobre VHF, el Virtual HID Framework de
; Windows). Un dispositivo raíz, ROOT\OSMSPAD: este driver va como filtro encima de vhf.sys y
; crea un hijo HID por mando (ver Driver.cpp). Sin driver de kernel propio.
;
; Basado en el INF de libvirtualgamepad (Copyright (c) 2026 Chase Payne, MIT). Windows 10 2004
; como mínimo: es lo que tiene probado esa referencia con VHF desde UMDF.
;
; Se quita del todo con: devcon remove ROOT\OSMSPAD (o pnputil /remove-device) y
; pnputil /delete-driver oemNN.inf /uninstall

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = OsmsPad.cat
DriverVer   = 11/14/2026,0.1.0.0 ; stampinf la sobrescribe al compilar
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...19041,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...19041]
%DeviceName% = OsmsPad_Win10, ROOT\OSMSPAD

[Standard.NT$ARCH$.10.0...22000]
%DeviceName% = OsmsPad_Win11, ROOT\OSMSPAD

[SourceDisksFiles]
OsmsPad.dll = 1

[SourceDisksNames]
1 = %DiskName%

[DestinationDirs]
OsmsPad.CopyFiles = 13 ; Driver Store: nada se copia a System32

[OsmsPad.CopyFiles]
OsmsPad.dll

; ---- Windows 10: WUDFRD.inf aún no trae las secciones de filtro, se añade a mano ----

[OsmsPad_Win10.NT]
Include  = hidvhf.inf
Needs    = vhfservice.NT
CopyFiles = OsmsPad.CopyFiles

[OsmsPad_Win10.NT.HW]
Include = hidvhf.inf
Needs   = vhfservice.NT.HW
AddReg  = OsmsPad.Security

[OsmsPad_Win10.NT.Services]
Include    = hidvhf.inf
Needs      = vhfservice.NT.Services
AddService = WUDFRd,0x000001f8,WUDFRd_ServiceInstall

[OsmsPad_Win10.NT.Filters]
AddFilter = WUDFRd,,WUDFRd_UpperFilterPosition

[OsmsPad_Win10.NT.Wdf]
UmdfService                = OsmsPad,OsmsPad_Wdf
UmdfServiceOrder           = OsmsPad
UmdfImpersonationLevel     = Impersonation
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy       = AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy     = CannotUseFsContexts

[WUDFRd_UpperFilterPosition]
FilterPosition = Upper

[WUDFRd_ServiceInstall]
DisplayName   = %WUDFRdServiceName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WUDFRd.sys

; ---- Windows 11 ----

[OsmsPad_Win11.NT]
Include  = WUDFRD.inf,hidvhf.inf
Needs    = WUDFRD_UpperFilter.NT,vhfservice.NT
CopyFiles = OsmsPad.CopyFiles

[OsmsPad_Win11.NT.HW]
Include = WUDFRD.inf,hidvhf.inf
Needs   = WUDFRD_UpperFilter.NT.HW,vhfservice.NT.HW
AddReg  = OsmsPad.Security

[OsmsPad_Win11.NT.Services]
Include = WUDFRD.inf,hidvhf.inf
Needs   = WUDFRD_UpperFilter.NT.Services,vhfservice.NT.Services

[OsmsPad_Win11.NT.Filters]
Include = WUDFRD.inf
Needs   = WUDFRD_UpperFilter.NT.Filters

[OsmsPad_Win11.NT.Wdf]
UmdfService                = OsmsPad,OsmsPad_Wdf
UmdfServiceOrder           = OsmsPad
UmdfImpersonationLevel     = Impersonation
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy       = AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy     = CannotUseFsContexts

; ---- Común ----

; Solo SYSTEM (Sunshine lo lanza el servicio como SYSTEM en la sesión) y administradores pueden
; crear mandos. UD es el SID del host UMDF, que abre el destino local hacia VHF.
[OsmsPad.Security]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;UD)"

[OsmsPad_Wdf]
UmdfLibraryVersion = $UMDFVERSION$
ServiceBinary      = %13%\OsmsPad.dll

[Strings]
ManufacturerName  = "OpenStreamMS"
DeviceName        = "OpenStreamMS Virtual Gamepad"
DiskName          = "OpenStreamMS Virtual Gamepad Driver"
WUDFRdServiceName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
